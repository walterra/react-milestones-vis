{
  "name": "react-milestones-vis",
  "version": "0.6.5",
  "description": "React component for d3-milestones, a d3 based timeline visualization.",
  "keywords": [
    "react",
    "d3",
    "visualization",
    "timeline"
  ],
  "homepage": "https://github.com/walterra/react-milestones-vis",
  "repository": {
    "type": "git",
    "url": "https://github.com/walterra/react-milestones-vis.git"
  },
  "bugs": {
    "url": "https://github.com/walterra/react-milestones-vis/issues"
  },
  "license": "Apache-2.0",
  "contributors": [
    "Walter Rafelsberger <walter.rafelsberger@elastic.co>"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "main": "./build/index.js",
  "module": "./build/index.es.js",
  "types": "./build/index.d.ts",
  "files": [
    "build"
  ],
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:examples": "rollup -c rollup.config-example.js &&node scripts/build-examples.js",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:react18": "jest --config jest.config.js --selectProjects=react-18",
    "test:react19": "jest --config jest.config.js --selectProjects=react-19",
    "test:visual": "jest --config jest.config.js --selectProjects=visual-snapshots",
    "test:visual:update": "jest --config jest.config.js --selectProjects=visual-snapshots --updateSnapshot",
    "test:react-ssr": "node scripts/test-react-ssr.js",
    "storybook": "storybook dev -p 6006",
    "deploy-storybook": "gh-pages -d storybook-static",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx src --fix",
    "check:all": "yarn typecheck && yarn lint",
    "test:supported": "yarn test:react18 --runInBand && yarn test:react19 --runInBand",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "yarn check:all && yarn test:supported && yarn build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "d3-milestones": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@changesets/cli": "^2.29.8",
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/preset-create-react-app": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-webpack5": "^10.5.10",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^27.0.3",
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/node": "^16.11.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "axios": "^1.9.0",
    "babel-jest": "^29.7.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "gh-pages": "^3.2.3",
    "globals": "^16.4.0",
    "jest": "^27.4.7",
    "jest-image-snapshot": "^6.4.0",
    "postcss": "^8.4.5",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-18": "npm:react@18.3.1",
    "react-19": "npm:react@19.2.8",
    "react-dom": "19.2.8",
    "react-dom-18": "npm:react-dom@18.3.1",
    "react-dom-19": "npm:react-dom@19.2.8",
    "rollup": "^4.40.2",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "^3.0.0",
    "storybook": "^10.5.10",
    "testing-library-react-18": "npm:@testing-library/react@^16.3.0",
    "testing-library-react-19": "npm:@testing-library/react@^16.3.0",
    "ts-jest": "^29.3.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "web-vitals": "^2.1.2",
    "webpack": "^5.65.0"
  }
}
